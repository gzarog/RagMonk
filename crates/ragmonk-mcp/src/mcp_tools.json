[
 {
  "name": "ragmonk_explore",
  "description": "Primary retrieval tool: plan + run the best deterministic strategies for a query and assemble a budgeted evidence package.",
  "inputSchema": {
   "properties": {
    "query": {
     "title": "Query",
     "type": "string"
    },
    "max_chars": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Max Chars"
    },
    "max_files": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Max Files"
    },
    "max_graph_nodes": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Max Graph Nodes"
    }
   },
   "required": [
    "query"
   ],
   "title": "ragmonk_exploreArguments",
   "type": "object"
  },
  "outputSchema": {
   "$defs": {
    "EvidenceRef": {
     "description": "An ``EvidenceFact`` plus the source snippet that lets a reader\ninterpret it -- ``retrieval/context_builder.py``'s budgeted\n``EvidenceItem.to_dict()`` shape, used by ``ragmonk_explore``.",
     "properties": {
      "source": {
       "title": "Source",
       "type": "string"
      },
      "path": {
       "title": "Path",
       "type": "string"
      },
      "location": {
       "additionalProperties": true,
       "title": "Location",
       "type": "object"
      },
      "entity": {
       "title": "Entity",
       "type": "string"
      },
      "relationship": {
       "title": "Relationship",
       "type": "string"
      },
      "confidence": {
       "title": "Confidence",
       "type": "string"
      },
      "snippet": {
       "title": "Snippet",
       "type": "string"
      }
     },
     "required": [
      "source",
      "path",
      "location",
      "entity",
      "relationship",
      "confidence",
      "snippet"
     ],
     "title": "EvidenceRef",
     "type": "object"
    },
    "ExploreEntity": {
     "description": "A resolved symbol as ``explore``'s query planner sees it -- fewer\nfields than a full ``EntityMatch`` (no file/line/signature detail;\nthat lives in ``evidence`` instead).",
     "properties": {
      "entity_id": {
       "title": "Entity Id",
       "type": "string"
      },
      "qualified_name": {
       "title": "Qualified Name",
       "type": "string"
      },
      "kind": {
       "title": "Kind",
       "type": "string"
      },
      "source_id": {
       "title": "Source Id",
       "type": "string"
      }
     },
     "required": [
      "entity_id",
      "qualified_name",
      "kind",
      "source_id"
     ],
     "title": "ExploreEntity",
     "type": "object"
    },
    "LexicalHit": {
     "description": "One ranked lexical result -- ``retrieval/lexical.py``'s\n``SearchResult.to_dict()`` shape, shared by ``ragmonk_search`` and\n``ragmonk_explore``'s ``documents`` list.",
     "properties": {
      "kind": {
       "title": "Kind",
       "type": "string"
      },
      "tier": {
       "title": "Tier",
       "type": "string"
      },
      "id": {
       "title": "Id",
       "type": "string"
      },
      "title": {
       "title": "Title",
       "type": "string"
      },
      "path": {
       "title": "Path",
       "type": "string"
      },
      "source_id": {
       "title": "Source Id",
       "type": "string"
      },
      "snippet": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Snippet"
      },
      "location": {
       "anyOf": [
        {
         "additionalProperties": true,
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Location"
      }
     },
     "required": [
      "kind",
      "tier",
      "id",
      "title",
      "path",
      "source_id"
     ],
     "title": "LexicalHit",
     "type": "object"
    },
    "RelationshipEdge": {
     "properties": {
      "source": {
       "title": "Source",
       "type": "string"
      },
      "relationship": {
       "title": "Relationship",
       "type": "string"
      },
      "target": {
       "title": "Target",
       "type": "string"
      },
      "confidence": {
       "title": "Confidence",
       "type": "string"
      }
     },
     "required": [
      "source",
      "relationship",
      "target",
      "confidence"
     ],
     "title": "RelationshipEdge",
     "type": "object"
    },
    "ToolError": {
     "description": "A clear, typed error -- never a raw traceback. ``type`` is the\nRagMonk exception class name (``\"UsageError\"``, ``\"ConfigError\"``,\n...) or one of this module's own boundary types (``\"timeout\"``,\n``\"internal_error\"``), so a client can branch on it without parsing\nprose.",
     "properties": {
      "type": {
       "title": "Type",
       "type": "string"
      },
      "message": {
       "title": "Message",
       "type": "string"
      }
     },
     "required": [
      "type",
      "message"
     ],
     "title": "ToolError",
     "type": "object"
    }
   },
   "properties": {
    "schema_version": {
     "default": "1",
     "title": "Schema Version",
     "type": "string"
    },
    "ok": {
     "title": "Ok",
     "type": "boolean"
    },
    "error": {
     "anyOf": [
      {
       "$ref": "#/$defs/ToolError"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "query": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Query"
    },
    "intent": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Intent"
    },
    "strategies": {
     "items": {
      "type": "string"
     },
     "title": "Strategies",
     "type": "array"
    },
    "answer_context": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Answer Context"
    },
    "entities": {
     "items": {
      "$ref": "#/$defs/ExploreEntity"
     },
     "title": "Entities",
     "type": "array"
    },
    "relationships": {
     "items": {
      "$ref": "#/$defs/RelationshipEdge"
     },
     "title": "Relationships",
     "type": "array"
    },
    "documents": {
     "items": {
      "$ref": "#/$defs/LexicalHit"
     },
     "title": "Documents",
     "type": "array"
    },
    "tests": {
     "items": {
      "type": "string"
     },
     "title": "Tests",
     "type": "array"
    },
    "evidence": {
     "items": {
      "$ref": "#/$defs/EvidenceRef"
     },
     "title": "Evidence",
     "type": "array"
    },
    "warnings": {
     "items": {
      "type": "string"
     },
     "title": "Warnings",
     "type": "array"
    }
   },
   "required": [
    "ok"
   ],
   "title": "ExploreOutput",
   "type": "object"
  },
  "annotations": {
   "readOnlyHint": true,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false
  }
 },
