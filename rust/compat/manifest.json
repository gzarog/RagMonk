{
  "manifest_version": 1,
  "reference_commit": "1e92ed42e258898572e8dc57b1ce2608435686d9",
  "env": [["RAGMONK_SEARCH__SEMANTIC", "false"]],
  "scenarios": [
    {
      "id": "cli-basics",
      "description": "Version, help and usage-error exit codes on a fresh home.",
      "steps": [
        {"id": "version-json", "args": ["version", "--json"], "volatile_keys": ["version"], "drop_keys": ["python", "runtime"], "rust_phase": "RUST-00"},
        {"id": "unknown-command", "args": ["definitely-not-a-command"], "output": "none", "rust_phase": "RUST-00"},
        {"id": "status-before-init", "args": ["status", "--json"], "rust_phase": "RUST-12"}
      ]
    },
    {
      "id": "config-defaults",
      "description": "init writes the default config; config show/get reflect it.",
      "steps": [
        {"id": "init", "args": ["init"], "output": "text", "rust_phase": "RUST-12"},
        {"id": "config-show", "args": ["config", "show"], "output": "yaml", "rust_phase": "RUST-01"},
        {"id": "config-get-storage", "args": ["config", "get", "storage"], "output": "text", "rust_phase": "RUST-12"},
        {"id": "config-get-scalar", "args": ["config", "get", "runtime.max_workers"], "output": "text", "rust_phase": "RUST-01"},
        {"id": "config-get-unknown", "args": ["config", "get", "no.such.key"], "output": "none", "rust_phase": "RUST-01", "compare_stderr": true},
        {"id": "home-inventory", "sqlite_inventory": true}
      ]
    },
    {
      "id": "code-docs-index",
      "description": "Index the seven-language code fixtures plus Markdown/TXT/CSV/HTML and EML-with-attachments documents, then query knowledge.",
      "fixtures": [
        {"from": "tests/fixtures/languages", "to": "code"},
        {"from": "tests/fixtures/documents/simple.md", "to": "docs/simple.md"},
        {"from": "tests/fixtures/documents/simple.txt", "to": "docs/simple.txt"},
        {"from": "tests/fixtures/documents/simple.csv", "to": "docs/simple.csv"},
        {"from": "tests/fixtures/documents/simple.html", "to": "docs/simple.html"},
        {"from": "tests/fixtures/documents/email_with_attachments.eml", "to": "docs/email_with_attachments.eml"}
      ],
      "steps": [
        {"id": "init", "args": ["init"], "output": "text", "rust_phase": "RUST-12"},
        {"id": "source-add", "args": ["source", "add", "{source}"], "output": "text",
         "capture": {"name": "source_id", "regex": "(src_[0-9a-f]+)"}, "rust_phase": "RUST-12"},
        {"id": "index", "args": ["index"], "output": "text", "rust_phase": "RUST-12"},
        {"id": "reindex-unchanged", "args": ["index"], "output": "text", "rust_phase": "RUST-12"},
        {"id": "status", "args": ["status", "--json"], "rust_phase": "RUST-11"},
        {"id": "search-bark", "args": ["search", "bark", "--json"], "rust_phase": "RUST-10"},
        {"id": "symbol-dog", "args": ["symbol", "Dog", "--json"], "rust_phase": "RUST-10"},
        {"id": "callers-speak", "args": ["callers", "speak", "--json"], "unordered_arrays": ["edges"], "rust_phase": "RUST-10"},
        {"id": "callees-bark", "args": ["callees", "bark", "--json"], "unordered_arrays": ["edges"], "rust_phase": "RUST-10"},
        {"id": "docs", "args": ["docs", "--json"], "rust_phase": "RUST-07"},
        {"id": "knowledge-inventory", "sqlite_inventory": true}
      ]
    }
  ]
}
